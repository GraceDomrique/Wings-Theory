# Databases — live/working databases are never versioned; production data
# lives outside history. The one exception is the sanitized, read-only
# deployment snapshot under backend/deploy/, carved back out below.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
!backend/deploy/*.db
!backend/deploy/*.json
!backend/deploy/*.md

# Manual and automatic backups
backend/backups/

# Trained ML model artifacts (joblib/json) -- a local training run writes a
# new file here under a fresh hash every time, so the directory as a whole
# stays untracked (no diff-worthy churn from routine retraining). The
# artifacts the model registry currently calls "active" are the exception:
# those are committed by name below so a fresh clone can serve predictions
# without training anything itself. See scripts/build_github_deploy_snapshot.py.
backend/ml_artifacts/*
!backend/ml_artifacts/demand_prophet__2b2a7617aac9.joblib
!backend/ml_artifacts/flavor_consumption_isoforest__bb6cd0cedd20.joblib
!backend/ml_artifacts/fpgrowth_combos__8147c0d858f2.json
!backend/ml_artifacts/unli_consumption_isoforest__b686237424c8.joblib
!backend/ml_artifacts/MANIFEST.json
# stock_loss_isoforest's registered-active artifact is missing even at the
# source (see backend/deploy/SNAPSHOT_MANIFEST.json) -- nothing to commit
# for it. Startup (wt/ml_startup.py) already rolls back to the prior run
# and serves a live fallback in the meantime; this is not silently patched
# over here.

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Local environment / secrets
.env
.env.*
backend/.secret
backend/dev/.secret

# Runtime lock file created by wt/db.py's cross-process migration lock
*.migrate.lock

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
.claude/
