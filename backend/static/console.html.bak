<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wings Theory — Operations Console</title>
<style>
:root{
  color-scheme: light dark;
  --amber:#F4B400; --amber-press:#DCA200; --amber-text:#8A6100; --amber-wash:#FEF6E0;
  --charcoal:#1F1F1F;
  --bg:#F7F8FA; --card:#FFFFFF; --sunken:#F2F4F7;
  --text:#2D2D2D; --text-2:#6B7280; --text-3:#9AA1AC; --border:#E5E7EB; --border-soft:#EFF1F4;
  --ok-fill:#34C759; --ok-text:#1B6E3C; --ok-wash:#EAF7EE;
  --warn-fill:#FF9500; --warn-text:#8A5000; --warn-wash:#FFF4E5;
  --bad-fill:#FF3B30; --bad-text:#B3261E; --bad-wash:#FEECEB;
  --info-fill:#3B82F6; --info-text:#1D4ED8; --info-wash:#EAF1FE;
  --fore-fill:#8B5CF6; --fore-text:#6D28D9; --fore-wash:#F1ECFE;
  --sh-1:0 1px 2px rgba(16,24,40,.05); --sh-2:0 1px 3px rgba(16,24,40,.08);
  --rail:236px;
}
/* Same brand palette (amber/charcoal), re-tuned for a dark surface: washes
   go from pale-on-white to translucent-on-dark, and the *-text colors that
   sit on those washes get lightened to stay readable — a dark-mode chip
   using the light-mode's dark-green text would be near-invisible. */
@media (prefers-color-scheme: dark){
  :root{
    --amber:#F4B400; --amber-press:#FFC933; --amber-text:#FFD166; --amber-wash:rgba(244,180,0,.16);
    --bg:#15161A; --card:#1D1F23; --sunken:#25272C;
    --text:#EDEEF0; --text-2:#A6ABB3; --text-3:#83878F; --border:#34363C; --border-soft:#2A2C31;
    --ok-fill:#34C759; --ok-text:#4ADE80; --ok-wash:rgba(52,199,89,.16);
    --warn-fill:#FF9F0A; --warn-text:#FFB84D; --warn-wash:rgba(255,159,10,.16);
    --bad-fill:#FF453A; --bad-text:#FF8079; --bad-wash:rgba(255,69,58,.16);
    --info-fill:#5E9EFF; --info-text:#8AB6FF; --info-wash:rgba(94,158,255,.16);
    --fore-fill:#A78BFA; --fore-text:#C7B6FC; --fore-wash:rgba(167,139,250,.16);
    --sh-1:0 1px 2px rgba(0,0,0,.5); --sh-2:0 2px 6px rgba(0,0,0,.55);
  }
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;font-size:13.5px}
button{font:inherit;cursor:pointer;background:none;border:0}
input,select{font:inherit;background:var(--card);color:var(--text)}
.num{font-variant-numeric:tabular-nums}
a{color:inherit}

/* ---------------- login ---------------- */
#login{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
  background:var(--charcoal);padding:20px}
.login-box{background:var(--card);border-radius:16px;padding:32px 28px;width:100%;max-width:360px;
  box-shadow:0 20px 50px rgba(0,0,0,.3)}
.login-box h1{font-size:20px;margin:0 0 4px}
.login-box p{color:var(--text-3);font-size:13px;margin:0 0 22px}
.field{width:100%;height:44px;border:1px solid var(--border);border-radius:10px;padding:0 14px;
  font-size:16px;margin-bottom:12px}
.field:focus{outline:none;border-color:var(--amber)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:38px;padding:0 14px;
  border-radius:10px;font-weight:600;font-size:13px}
.btn-full{width:100%;height:44px;font-size:15px}
.btn-p{background:var(--amber);color:var(--charcoal)}
.btn-p:hover{background:var(--amber-press)}
.btn-s{background:var(--card);border:1px solid var(--border);color:var(--text)}
.btn-s:hover{background:var(--sunken)}
.btn-d{background:var(--bad-fill);color:#fff}
.btn:disabled{opacity:.5;pointer-events:none}
#loginErr{color:var(--bad-text);font-size:13px;margin-top:10px;min-height:16px}

/* ---------------- shell ---------------- */
.app{display:grid;grid-template-columns:var(--rail) 1fr;min-height:100vh}
.rail{background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column}
.brand{height:56px;display:flex;align-items:center;gap:10px;padding:0 18px;border-bottom:1px solid var(--border-soft)}
.brand b{font-size:13.5px;font-weight:700}
.brand span{font-size:10px;color:var(--text-3);letter-spacing:.05em;text-transform:uppercase;display:block}
.nav{flex:1;overflow-y:auto;padding:14px 10px;display:flex;flex-direction:column;gap:2px}
.nav-lbl{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  color:var(--text-3);padding:14px 10px 5px}
.nav-i{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;
  color:var(--text-2);font-size:13px;font-weight:500;width:100%;text-align:left;position:relative}
.nav-i:hover{background:var(--sunken);color:var(--text)}
.nav-i.on{background:var(--amber-wash);color:var(--amber-text);font-weight:600}
.nav-i .ic{width:16px;text-align:center;flex-shrink:0}
.nav-i .badge{margin-left:auto;background:var(--bad-fill);color:#fff;font-size:10px;font-weight:700;
  padding:1px 6px;border-radius:99px}
.rail-foot{border-top:1px solid var(--border-soft);padding:12px;display:flex;align-items:center;gap:9px}
.avatar{width:28px;height:28px;border-radius:99px;background:var(--charcoal);color:var(--amber);
  display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}
.who{flex:1;overflow:hidden}
.who b{font-size:12px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.who span{font-size:10.5px;color:var(--text-3)}

.main{min-width:0;display:flex;flex-direction:column}
header{height:56px;background:var(--card);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:12px;padding:0 22px;position:sticky;top:0;z-index:5}
header h1{font-size:15px;font-weight:700;margin:0}
header .sub{font-size:11.5px;color:var(--text-3)}
header .r{margin-left:auto;display:flex;gap:8px}
#errBanner{background:var(--bad-wash);color:var(--bad-text);padding:9px 22px;font-size:12.5px;
  display:flex;align-items:center;gap:10px}
#errBanner button{border:1px solid var(--bad-text);border-radius:7px;padding:4px 10px;
  font-size:11.5px;color:var(--bad-text);margin-left:auto}
.hide{display:none!important}
.work{padding:22px;display:flex;flex-direction:column;gap:18px;max-width:1280px;width:100%;margin:0 auto}

/* ---------------- primitives ---------------- */
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--sh-1)}
.card-h{display:flex;align-items:flex-start;gap:12px;padding:14px 18px;border-bottom:1px solid var(--border-soft)}
.card-h h2{font-size:13.5px;font-weight:700;margin:0}
.card-h p{font-size:11.5px;color:var(--text-3);margin:2px 0 0}
.card-h .r{margin-left:auto;display:flex;gap:6px;flex-shrink:0}
.card-b{padding:18px}
.card-b.tight{padding:10px}

.grid{display:grid;gap:12px}
.g2{grid-template-columns:repeat(2,1fr)} .g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
@media(max-width:1000px){.g4{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(2,1fr)}}

.kpi{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;box-shadow:var(--sh-1)}
.kpi .l{font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.04em;display:flex;gap:6px;align-items:center}
.kpi .v{font-size:23px;font-weight:700;margin-top:5px}
.kpi .f{font-size:11px;color:var(--text-3);margin-top:4px}

.tabs{display:flex;gap:3px;background:var(--sunken);padding:3px;border-radius:9px;width:fit-content;flex-wrap:wrap}
.tab{padding:6px 12px;border-radius:7px;font-size:12px;font-weight:500;color:var(--text-2)}
.tab.on{background:var(--card);color:var(--text);font-weight:600;box-shadow:var(--sh-1)}

.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:560px}
thead th{text-align:left;font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--text-3);
  padding:9px 14px;border-bottom:1px solid var(--border);white-space:nowrap}
td{padding:9px 14px;border-bottom:1px solid var(--border-soft);font-size:12.5px;white-space:nowrap}
td.wrap{white-space:normal}
td.n{text-align:right;font-variant-numeric:tabular-nums}
th.n{text-align:right}
tbody tr:hover{background:var(--sunken)}
tbody tr:last-child td{border-bottom:0}
.nm{font-weight:600;color:var(--text)}
.sub{font-size:10.5px;color:var(--text-3)}

.chip{font-size:10px;font-weight:700;padding:2px 8px;border-radius:99px;white-space:nowrap;display:inline-block}
.chip.ok{background:var(--ok-wash);color:var(--ok-text)}
.chip.warn{background:var(--warn-wash);color:var(--warn-text)}
.chip.bad{background:var(--bad-wash);color:var(--bad-text)}
.chip.info{background:var(--info-wash);color:var(--info-text)}
.chip.fore{background:var(--fore-wash);color:var(--fore-text)}
.chip.mute{background:var(--sunken);color:var(--text-2)}

.field-sm{height:32px;border:1px solid var(--border);border-radius:8px;padding:0 10px;font-size:12.5px}
.search{position:relative}
.search input{padding-left:30px}
.search svg{position:absolute;left:9px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--text-3)}

.empty{text-align:center;padding:44px 20px;color:var(--text-3)}
.empty b{display:block;color:var(--text);font-size:13px;margin-bottom:4px}
.empty p{font-size:12px;margin:0}

.stub{background:var(--fore-wash);border-radius:10px;padding:16px 18px;display:flex;gap:12px}
.stub svg{width:18px;height:18px;color:var(--fore-text);flex-shrink:0;margin-top:1px}
.stub b{color:var(--fore-text);display:block;font-size:13px}
.stub p{font-size:12.5px;color:var(--text-2);margin:6px 0 0;line-height:1.5}

.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.scrim{position:fixed;inset:0;background:rgba(16,24,40,.35);z-index:20}
.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--card);
  border-radius:14px;padding:22px;width:min(400px,92vw);z-index:21;box-shadow:0 20px 50px rgba(0,0,0,.25);
  max-height:82vh;overflow-y:auto}
.modal h3{margin:0 0 4px;font-size:15px}
.modal p{margin:0 0 14px;font-size:12px;color:var(--text-3)}
.modal label{display:block;font-size:11.5px;font-weight:600;margin:12px 0 5px}
.modal .actions{display:flex;gap:8px;margin-top:18px}
.modal .actions .btn{flex:1}
#modalErr{color:var(--bad-text);font-size:12px;margin-top:8px;display:none}

.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--charcoal);
  color:#fff;padding:12px 20px;border-radius:11px;font-size:13.5px;z-index:80;box-shadow:0 8px 26px rgba(0,0,0,.3)}

.bar-wrap{display:flex;align-items:flex-end;gap:6px;height:140px;padding-top:10px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.bar-col .bar{width:100%;border-radius:4px 4px 0 0;background:var(--amber);min-height:2px}
.bar-col .lbl{font-size:10px;color:var(--text-3)}
.bar-col .val{font-size:10.5px;font-weight:600;color:var(--text)}

@media(max-width:900px){.app{grid-template-columns:1fr}.rail{display:none}}
@media print{
  .rail,header,#errBanner,.btn,.tabs{display:none!important}
  .app{display:block}
  .work{padding:0;max-width:none}
  .card{box-shadow:none;border:1px solid #999;break-inside:avoid}
  body{font-size:11px}
}
</style>
</head>
<body>

<div id="login">
  <div class="login-box">
    <h1>Wings Theory</h1>
    <p>Operations console — manager sign in</p>
    <input class="field" id="luser" placeholder="Username" autocomplete="username">
    <input class="field" id="lpass" type="password" placeholder="Password" autocomplete="current-password">
    <button class="btn btn-p btn-full" id="loginBtn">Sign in</button>
    <div id="loginErr"></div>
  </div>
</div>

<div class="app" id="app" style="display:none">
  <aside class="rail">
    <div class="brand"><b>Wings Theory</b></div>
    <nav class="nav" id="nav"></nav>
    <div class="rail-foot">
      <div class="avatar" id="avatarIni"></div>
      <div class="who"><b id="whoName"></b><span id="whoRole"></span></div>
      <button class="btn btn-s" style="height:30px;padding:0 10px" id="logoutBtn">Out</button>
    </div>
  </aside>
  <div class="main">
    <header>
      <div><h1 id="pgTitle">Dashboard</h1><div class="sub" id="pgSub"></div></div>
      <div class="r"><button class="btn btn-s" id="refreshBtn">Refresh</button></div>
    </header>
    <div id="errBanner" class="hide"></div>
    <main class="work" id="work"></main>
  </div>
</div>

<script>
// ===========================================================================
// Auth — namespaced per app so a cashier/kitchen login elsewhere on this
// device never silently satisfies this console's auto-login check.
// ===========================================================================
const NS = 'wt_console_';
const ALLOWED_ROLES = ['manager', 'admin'];
let TOKEN = localStorage.getItem(NS + 'token');
let ROLE = localStorage.getItem(NS + 'role');
let NAME = localStorage.getItem(NS + 'name');

function $(sel, el) { return (el || document).querySelector(sel); }
function $all(sel, el) { return [...(el || document).querySelectorAll(sel)]; }
function esc(s) {
  return String(s === undefined || s === null ? '' : s).replace(/[&<>"']/g,
    c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function money(n) { return '₱' + (Number(n) || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function num(n, d) { return (Number(n) || 0).toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: d === undefined ? 1 : d }); }
function setWork(html) { $('#work').innerHTML = html; }

async function api(path, opts) {
  opts = opts || {};
  const headers = Object.assign({ 'Content-Type': 'application/json' }, opts.headers || {});
  const authed = !!TOKEN;
  if (TOKEN) headers['Authorization'] = 'Bearer ' + TOKEN;
  const res = await fetch(path, Object.assign({}, opts, { headers }));
  let body = null;
  try { body = await res.json(); } catch (e) { /* no body */ }
  if (!res.ok) {
    const msg = body && (body.detail || body.message)
      ? (typeof body.detail === 'string' ? body.detail : JSON.stringify(body.detail))
      : ('HTTP ' + res.status);
    if (res.status === 401 && authed) doLogout();
    throw new Error(msg);
  }
  return body;
}

async function doLogin() {
  const u = $('#luser').value.trim(), p = $('#lpass').value;
  const err = $('#loginErr');
  err.textContent = '';
  if (!u || !p) { err.textContent = 'Enter a username and password.'; return; }
  $('#loginBtn').disabled = true;
  try {
    const d = await api('/auth/login', { method: 'POST', body: JSON.stringify({ username: u, password: p }) });
    if (!ALLOWED_ROLES.includes(d.role)) {
      err.textContent = `This console is for managers and admins only (your role: ${d.role}).`;
      return;
    }
    TOKEN = d.token; ROLE = d.role; NAME = d.display_name || u;
    localStorage.setItem(NS + 'token', TOKEN);
    localStorage.setItem(NS + 'role', ROLE);
    localStorage.setItem(NS + 'name', NAME);
    boot();
  } catch (e) {
    err.textContent = e.message;
  } finally {
    $('#loginBtn').disabled = false;
  }
}
function doLogout() {
  localStorage.removeItem(NS + 'token'); localStorage.removeItem(NS + 'role'); localStorage.removeItem(NS + 'name');
  TOKEN = ROLE = NAME = null;
  $('#app').style.display = 'none';
  $('#login').style.display = 'flex';
  $('#lpass').value = '';
}
$('#loginBtn').addEventListener('click', doLogin);
$('#lpass').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
$('#luser').addEventListener('keydown', e => { if (e.key === 'Enter') $('#lpass').focus(); });
$('#logoutBtn').addEventListener('click', doLogout);

function showErr(msg) {
  const b = $('#errBanner');
  b.innerHTML = `<span>${esc(msg)}</span><button id="errRetry">Retry</button>`;
  b.classList.remove('hide');
  $('#errRetry').addEventListener('click', () => CURRENT && goto(CURRENT));
}
function clearErr() { $('#errBanner').classList.add('hide'); $('#errBanner').innerHTML = ''; }
function toast(msg) {
  const t = document.createElement('div');
  t.className = 'toast'; t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2800);
}

// ===========================================================================
// Shared render helpers
// ===========================================================================
function kpi(label, value, foot) {
  return `<div class="kpi"><div class="l">${esc(label)}</div><div class="v num">${esc(String(value))}</div>${foot ? `<div class="f">${esc(foot)}</div>` : ''}</div>`;
}
function emptyState(title, body) {
  return `<div class="empty"><b>${esc(title)}</b><p>${esc(body || '')}</p></div>`;
}
function statusChip(s) {
  const map = { punched: 'info', in_progress: 'warn', ready: 'warn', served: 'ok', void: 'bad' };
  return `<span class="chip ${map[s] || 'mute'}">${esc(String(s).replace(/_/g, ' '))}</span>`;
}
const REASON_LABELS = {
  purchase_receipt: 'Delivery received',
  sale_commit: 'Sold',
  void_credit: 'Cancelled order — stock returned',
  wastage: 'Thrown away / wasted',
  spoilage: 'Spoiled / expired',
  count_adjustment: 'Manual count correction',
  transfer: 'Moved to another location',
  unli_provisional: 'Unlimited wings — running estimate',
  unli_reconcile: 'Unlimited wings — end-of-order adjustment',
};
function reasonLabel(r) { return REASON_LABELS[r] || String(r).replace(/_/g, ' '); }
function reasonChip(r) {
  const good = ['purchase_receipt', 'void_credit'];
  const bad = ['wastage', 'spoilage'];
  const cls = good.includes(r) ? 'ok' : bad.includes(r) ? 'bad' : 'mute';
  return `<span class="chip ${cls}">${esc(reasonLabel(r))}</span>`;
}
function expiryChip(b) {
  if (b.expired) return `<span class="chip bad">expired</span>`;
  if (b.days_to_expiry <= 3) return `<span class="chip bad">${b.days_to_expiry}d left</span>`;
  if (b.days_to_expiry <= 7) return `<span class="chip warn">${b.days_to_expiry}d left</span>`;
  return `<span class="chip ok">${b.days_to_expiry}d left</span>`;
}
function barChart(items, opt) {
  if (!items.length) return emptyState('No data yet', '');
  const max = Math.max(...items.map(i => Number(i[opt.value]) || 0), 1);
  return `<div class="bar-wrap">${items.map(i => {
    const v = Number(i[opt.value]) || 0;
    const h = Math.max(2, Math.round((v / max) * 120));
    return `<div class="bar-col"><div class="val">${opt.isMoney ? money(v) : num(v)}</div>` +
      `<div class="bar" style="height:${h}px"></div><div class="lbl">${esc(String(i[opt.label]).slice(0, 12))}</div></div>`;
  }).join('')}</div>`;
}
function downloadCsv(filename, rowsArr, cols) {
  const q = v => `"${String(v === undefined || v === null ? '' : v).replace(/"/g, '""')}"`;
  const lines = [cols.map(c => q(c.label)).join(',')]
    .concat(rowsArr.map(r => cols.map(c => q(typeof c.get === 'function' ? c.get(r) : r[c.key])).join(',')));
  const blob = new Blob([lines.join('\r\n')], { type: 'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 2000);
}

// ===========================================================================
// Modals
// ===========================================================================
function openModal(html) {
  closeModal();
  const scrim = document.createElement('div'); scrim.className = 'scrim'; scrim.id = 'scrim';
  scrim.addEventListener('click', closeModal);
  document.body.appendChild(scrim);
  const modal = document.createElement('div'); modal.className = 'modal'; modal.id = 'modalBox';
  modal.innerHTML = html;
  modal.addEventListener('click', e => e.stopPropagation());
  document.body.appendChild(modal);
}
function closeModal() {
  const s = $('#scrim'); if (s) s.remove();
  const m = $('#modalBox'); if (m) m.remove();
}
function modalError(msg) {
  const err = $('#modalErr'); if (!err) return;
  err.textContent = msg; err.style.display = 'block';
}

function openReceiveModal(id, name, purchaseUnit) {
  openModal(`
    <h3>Log a delivery</h3>
    <p>${esc(name)}</p>
    <label>How much arrived (in ${esc(purchaseUnit)})</label>
    <input class="field" id="rcQty" type="number" min="0.01" step="0.01" placeholder="e.g. 5">
    <label>Reference number (optional)</label>
    <input class="field" id="rcLot" placeholder="e.g. supplier receipt number">
    <label>Expiry date, if it has one (optional)</label>
    <input class="field" id="rcExp" type="date">
    <div id="modalErr"></div>
    <div class="actions"><button class="btn btn-s" data-act="modal-cancel">Cancel</button><button class="btn btn-p" id="rcSubmit">Save delivery</button></div>
  `);
  $('#rcSubmit').addEventListener('click', async () => {
    const qty = parseFloat($('#rcQty').value);
    if (!qty || qty <= 0) { modalError('Enter a quantity greater than zero.'); return; }
    $('#rcSubmit').disabled = true;
    try {
      const r = await api(`/console/ingredients/${id}/receive`, {
        method: 'POST', body: JSON.stringify({
          purchase_qty: qty, lot_no: $('#rcLot').value || null, expires_at: $('#rcExp').value || null,
        })
      });
      closeModal();
      toast(`Received ${r.received_base} ${r.base_unit} of ${r.name}. On hand: ${r.on_hand_base} ${r.base_unit}.`);
      if (CURRENT === 'inventory') loadInventory();
      else if (CURRENT === 'purchases') loadPurchases();
      else if (CURRENT) goto(CURRENT);
    } catch (e) { modalError(e.message); }
    finally { const b = $('#rcSubmit'); if (b) b.disabled = false; }
  });
}

function openCountModal(id, name, baseUnit, onHand) {
  openModal(`
    <h3>Count this ingredient</h3>
    <p>${esc(name)} — the system currently expects ${num(onHand, 2)} ${esc(baseUnit)} on hand, based on deliveries and recipe deductions so far.</p>
    <label>What did you actually count, right now (in ${esc(baseUnit)})?</label>
    <input class="field" id="ctQty" type="number" min="0" step="0.01" value="${num(onHand, 2)}">
    <label>Note (optional — helpful if the number is different)</label>
    <input class="field" id="ctNote" placeholder="e.g. some spilled during prep">
    <div id="modalErr"></div>
    <div class="actions"><button class="btn btn-s" data-act="modal-cancel">Cancel</button><button class="btn btn-p" id="ctSubmit">Save count</button></div>
  `);
  $('#ctSubmit').addEventListener('click', async () => {
    const qty = parseFloat($('#ctQty').value);
    if (isNaN(qty) || qty < 0) { modalError('Enter a number, zero or more.'); return; }
    $('#ctSubmit').disabled = true;
    try {
      const r = await api(`/console/ingredients/${id}/count`, {
        method: 'POST', body: JSON.stringify({ actual_base: qty, note: $('#ctNote').value || null }),
      });
      closeModal();
      if (Math.abs(r.variance_base) < 0.01) {
        toast(`Confirmed — matches what was expected.`);
      } else {
        const dir = r.variance_base > 0 ? 'more' : 'less';
        toast(`Recorded: ${Math.abs(r.variance_base).toFixed(2)} ${r.base_unit} ${dir} than expected.`);
      }
      if (CURRENT) goto(CURRENT);
    } catch (e) { modalError(e.message); }
    finally { const b = $('#ctSubmit'); if (b) b.disabled = false; }
  });
}

function openVerifyModal(id, field, name, current) {
  const titles = { pack_size: 'Confirm package size', yield_factor: 'Confirm usable percentage', unit_cost: 'Confirm cost' };
  const labels = {
    pack_size: 'How much is in one unit you buy (one sack, one bottle, one box)?',
    yield_factor: 'What percentage is actually usable after prep? (Enter 1 if nothing is wasted, 0.9 if 10% is trimmed off, etc.)',
    unit_cost: 'How much do you pay for one unit you buy?',
  };
  openModal(`
    <h3>${esc(titles[field] || 'Confirm this number')}</h3>
    <p>${esc(name)} — this was a placeholder guess: ${esc(current || 'none set')}</p>
    <label>${esc(labels[field] || field)}</label>
    <input class="field" id="vfVal" type="number" step="0.0001" value="${esc(current || '')}">
    <div id="modalErr"></div>
    <div class="actions"><button class="btn btn-s" data-act="modal-cancel">Cancel</button><button class="btn btn-p" id="vfSubmit">Save the real number</button></div>
  `);
  $('#vfSubmit').addEventListener('click', async () => {
    const val = parseFloat($('#vfVal').value);
    if (isNaN(val)) { modalError('Enter a number.'); return; }
    $('#vfSubmit').disabled = true;
    try {
      await api(`/console/ingredients/${id}/verify`, { method: 'POST', body: JSON.stringify({ field, value: val }) });
      closeModal(); toast('Saved.'); goto('verification');
    } catch (e) { modalError(e.message); }
    finally { const b = $('#vfSubmit'); if (b) b.disabled = false; }
  });
}

function openResolveModal(id, label) {
  const opts = (STATE.unmapped.ingredients || []).map(i => `<option value="${i.id}">${esc(i.name)}</option>`).join('');
  openModal(`
    <h3>Match this ingredient</h3>
    <p>Written in the recipe as: "${esc(label)}"</p>
    <label>Which real ingredient is this?</label>
    <select class="field" id="rsIng"><option value="">Select…</option>${opts}</select>
    <div id="modalErr"></div>
    <div class="actions"><button class="btn btn-s" data-act="modal-cancel">Cancel</button><button class="btn btn-p" id="rsSubmit">Match it</button></div>
  `);
  $('#rsSubmit').addEventListener('click', async () => {
    const ingId = parseInt($('#rsIng').value, 10);
    if (!ingId) { modalError('Choose an ingredient.'); return; }
    $('#rsSubmit').disabled = true;
    try {
      const r = await api(`/console/queues/unmapped/${id}/resolve`, {
        method: 'POST', body: JSON.stringify({ ingredient_pk: ingId, action: 'map' }),
      });
      closeModal(); toast(`Matched to ${r.mapped_to}.`); loadUnmapped();
    } catch (e) { modalError(e.message); }
    finally { const b = $('#rsSubmit'); if (b) b.disabled = false; }
  });
}
async function dismissUnmapped(id) {
  if (!confirm('Ignore this without matching it to an ingredient? It will stay unmatched.')) return;
  try {
    await api(`/console/queues/unmapped/${id}/resolve`, { method: 'POST', body: JSON.stringify({ action: 'dismiss' }) });
    toast('Ignored.'); loadUnmapped();
  } catch (e) { toast('Error: ' + e.message); }
}

// ===========================================================================
// App state
// ===========================================================================
const STATE = {
  readiness: null,
  inventory: { q: '', cat: '', onlyBlocked: false, data: [] },
  movements: { reason: '', offset: 0, limit: 50, data: null },
  recipes: { list: [], selectedId: null, detail: null },
  expiry: { within: 90, data: [] },
  verification: { data: null },
  unmapped: { data: null, ingredients: [] },
  reports: { days: 30, data: null },
  purchases: null,
  forecasts: { dep: [], dem: [] },
  anomaly: [],
};

// ===========================================================================
// Dashboard
// ===========================================================================
async function loadDashboard() {
  const [r, s30, s1, exp, dep, ing] = await Promise.all([
    api('/console/readiness'),
    api('/console/reports/sales?days=30'),
    api('/console/reports/sales?days=1'),
    api('/console/expiry?within_days=7'),
    api('/console/forecasts/depletion?lookback_days=30'),
    api('/console/ingredients?limit=500'),
  ]);
  STATE.readiness = r; renderNavBadges();
  STATE.inventory.data = ing.ingredients;   // so Reports' valuation stays warm without refetching

  const top = [...s30.by_item].sort((a, b) => b.revenue - a.revenue).slice(0, 8);
  const expiring = exp.batches.slice(0, 5);
  const toBuy = dep.ingredients
    .filter(i => i.suggested_order_qty != null)
    .sort((a, b) => (a.days_remaining ?? 1e9) - (b.days_remaining ?? 1e9))
    .slice(0, 8);
  const outCritical = dep.ingredients.filter(i => i.risk === 'out' || i.risk === 'critical').length;
  const warning = dep.ingredients.filter(i => i.risk === 'warning').length;
  const val = inventoryValuation();

  setWork(`
    <div class="grid g4">
      ${kpi("Today's revenue", money(s1.revenue), `${s1.orders} order${s1.orders === 1 ? '' : 's'}`)}
      ${kpi('30-day revenue', money(s30.revenue), `${s30.orders} orders`)}
      ${kpi('Stock on hand, valued', money(val.total), `${val.priced} of ${val.total_count} priced`)}
      ${kpi('Needs reordering', outCritical + warning, `${outCritical} urgent, ${warning} soon`)}
    </div>
    <div class="grid" style="grid-template-columns:1.6fr 1fr;align-items:start">
      <div class="card">
        <div class="card-h"><div><h2>Buy next</h2><p>Sized from real recent usage, covering delivery time plus a few days' buffer</p></div>
        <div class="r"><button class="btn btn-p" data-nav="inventory">Log a delivery</button></div></div>
        <div class="tw"><table><thead><tr><th>Ingredient</th><th class="n">On hand</th><th class="n">Days left</th><th class="n">Suggested order</th><th>Status</th></tr></thead>
        <tbody>${toBuy.length ? toBuy.map(i => `<tr>
          <td class="nm">${esc(i.name)}</td>
          <td class="n">${num(i.available_base, 2)} ${esc(i.base_unit)}</td>
          <td class="n">${i.days_remaining != null ? num(i.days_remaining, 1) : '—'}</td>
          <td class="n">${i.suggested_order_qty} ${esc(i.suggested_order_unit)}${i.suggested_order_qty === 1 ? '' : 's'}</td>
          <td>${riskChip(i.risk)}</td>
        </tr>`).join('') : `<tr><td colspan="5">${emptyState('Nothing needs reordering', 'Every ingredient has a comfortable buffer right now.')}</td></tr>`}</tbody></table></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:18px">
        <div class="card" id="tomorrowCard" style="display:${top.length ? 'block' : 'none'}">
          <div class="card-h"><h2>Tomorrow's forecast</h2></div>
          <div class="card-b"><span class="sub">Working…</span></div>
        </div>
        <div class="card">
          <div class="card-h"><h2>Menu availability</h2></div>
          <div class="card-b" style="display:flex;flex-direction:column;gap:14px">
            ${progressRow('Sellable right now', r.menu_items_sellable, r.menu_items_total)}
            ${progressRow('Ingredients ready', ing.ingredients.length - r.ingredients_blocked, ing.ingredients.length)}
            ${r.menu_items_blocked ? `<p class="sub" style="margin:0">${r.menu_items_blocked} item${r.menu_items_blocked === 1 ? '' : 's'} blocked — see Forecasts for which ingredient is out.</p>` : ''}
          </div>
        </div>
        <div class="card">
          <div class="card-h"><div><h2>Expiring within 7 days</h2></div><div class="r"><button class="btn btn-s" data-nav="expiry">View all</button></div></div>
          <div class="card-b tight">${expiring.length ? `<table><tbody>${expiring.map(b => `<tr><td class="nm">${esc(b.ingredient_name)}</td><td class="n">${expiryChip(b)}</td></tr>`).join('')}</tbody></table>` : emptyState('Nothing expiring soon', '')}</div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-h"><div><h2>Top sellers — last 30 days</h2><p>By revenue, real order data</p></div></div>
      <div class="card-b">${barChart(top, { label: 'name', value: 'revenue', isMoney: true })}</div>
    </div>
    <div class="card">
      <div class="card-h"><h2>Recent orders</h2></div>
      <div class="tw"><table><thead><tr><th>Order</th><th>Table</th><th>Status</th><th class="n">Total</th><th>When</th></tr></thead>
      <tbody>${s30.recent_orders.slice(0, 8).map(o => `<tr><td class="nm">${esc(o.order_no)}</td><td>${esc(o.table_label || '—')}</td><td>${statusChip(o.status)}</td><td class="n">${money(o.total)}</td><td class="sub">${esc(o.created_at)}</td></tr>`).join('') || `<tr><td colspan="5">${emptyState('No orders yet', '')}</td></tr>`}</tbody></table></div>
    </div>
  `);

  if (top.length) loadTomorrowForecast(top[0].name);
}

function progressRow(label, part, total) {
  const pct = total > 0 ? Math.round((part / total) * 100) : 0;
  const color = pct === 100 ? 'var(--ok-fill)' : pct >= 80 ? 'var(--warn-fill)' : 'var(--bad-fill)';
  return `<div>
    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px">
      <span>${esc(label)}</span><span class="nm">${part} / ${total}</span>
    </div>
    <div style="height:7px;border-radius:99px;background:var(--sunken);overflow:hidden">
      <div style="height:100%;width:${pct}%;background:${color};border-radius:99px"></div>
    </div>
  </div>`;
}

async function loadTomorrowForecast(itemName) {
  const item = STATE.forecasts.dem?.find?.(d => d.name === itemName)
    || (await api('/console/forecasts/demand')).items.find(d => d.name === itemName);
  if (!item || item.insufficient_data) return;
  try {
    const d = await api('/console/forecasts/demand?menu_item_pk=' + item.menu_item_id + '&horizon_days=1');
    if (d.insufficient_data || !d.forecast.length) return;
    const card = $('#tomorrowCard');
    if (!card) return;   // user navigated away while this was loading
    const tomorrow = d.forecast[0];
    const last7 = d.series.slice(-7);
    card.innerHTML = `
      <div class="card-h"><h2>Tomorrow's forecast</h2><p>${esc(itemName)}</p></div>
      <div class="card-b">
        <div class="v" style="font-size:26px;font-weight:700">${num(tomorrow.qty, 1)}<span class="sub" style="font-size:13px;font-weight:400"> predicted units</span></div>
        ${tomorrow.low !== undefined ? `<div class="sub" style="margin-top:2px">Likely between ${num(tomorrow.low, 1)} and ${num(tomorrow.high, 1)}</div>` : ''}
        <div style="margin-top:12px">${barChart(last7.map(p => ({ n: p.date.slice(5), v: p.qty })), { label: 'n', value: 'v' })}</div>
      </div>`;
  } catch (e) { /* dashboard stays fine without this card */ }
}

// ===========================================================================
// Inventory
// ===========================================================================
async function loadInventory() {
  const d = await api('/console/ingredients?limit=500');
  STATE.inventory.data = d.ingredients;
  renderInventory();
}
function renderInventory() {
  const st = STATE.inventory;
  const cats = ['', 'wet_food', 'dry_food', 'packaging', 'consumable', 'resale'];
  let list = st.data;
  if (st.cat) list = list.filter(i => i.category === st.cat);
  if (st.q) list = list.filter(i => i.name.toLowerCase().includes(st.q.toLowerCase()));
  if (st.onlyBlocked) list = list.filter(i => !i.is_deductable);
  setWork(`
    <div class="card">
      <div class="card-h">
        <div><h2>Ingredients</h2><p>${st.data.length} active · ${st.data.filter(i => !i.is_deductable).length} blocked</p></div>
        <div class="r">
          <label class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input class="field-sm" data-bind="inv-q" placeholder="Search ingredients" value="${esc(st.q)}" style="width:190px"></label>
          <label style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text-2)"><input type="checkbox" data-act="inv-blocked" ${st.onlyBlocked ? 'checked' : ''}> Blocked only</label>
        </div>
      </div>
      <div class="card-b tight" style="padding-top:14px">
        <div class="tabs">${cats.map(c => `<button class="tab ${st.cat === c ? 'on' : ''}" data-act="inv-cat" data-cat="${c}">${c === '' ? 'All' : esc(c.replace('_', ' '))}</button>`).join('')}</div>
      </div>
      <div class="tw"><table>
        <thead><tr><th>Ingredient</th><th>Category</th><th class="n">On hand</th><th class="n">Available</th><th class="n">Unit cost</th><th>Status</th><th></th></tr></thead>
        <tbody>${list.length ? list.map(i => `
          <tr>
            <td><div class="nm">${esc(i.name)}</div><div class="sub">${esc(i.ingredient_id)}</div></td>
            <td class="sub">${esc(i.category.replace('_', ' '))}</td>
            <td class="n">${esc(i.on_hand_display)}</td>
            <td class="n">${num(i.available_base)} ${esc(i.base_unit)}</td>
            <td class="n">${i.unit_cost != null ? money(i.unit_cost) : '—'}</td>
            <td>${i.is_deductable ? `<span class="chip ok">Ready</span>` : `<span class="chip bad" title="${esc(i.block_reason || '')}">${esc(i.block_reason || 'Blocked')}</span>`}${i.unverified_count ? ` <span class="chip warn">${i.unverified_count} to verify</span>` : ''}</td>
            <td class="toolbar">
              <button class="btn btn-s" style="height:28px;padding:0 10px" data-act="receive" data-id="${i.id}" data-name="${esc(i.name)}" data-unit="${esc(i.purchase_unit)}">Log delivery</button>
              <button class="btn btn-s" style="height:28px;padding:0 10px" data-act="count" data-id="${i.id}" data-name="${esc(i.name)}" data-baseunit="${esc(i.base_unit)}" data-onhand="${i.on_hand_base}">Count stock</button>
            </td>
          </tr>`).join('') : `<tr><td colspan="7">${emptyState('No ingredients match', 'Try a different search or clear the filter.')}</td></tr>`}
        </tbody>
      </table></div>
    </div>
  `);
}

// ===========================================================================
// Stock movements (ledger)
// ===========================================================================
async function loadMovements() { await fetchMovements(); }
async function fetchMovements() {
  const st = STATE.movements;
  const params = new URLSearchParams({ limit: st.limit, offset: st.offset });
  if (st.reason) params.set('reason', st.reason);
  st.data = await api('/console/ledger?' + params.toString());
  renderMovements();
}
function renderMovements() {
  const st = STATE.movements;
  const d = st.data || { entries: [], total: 0 };
  const reasons = ['', 'purchase_receipt', 'sale_commit', 'void_credit', 'wastage', 'spoilage', 'count_adjustment', 'transfer', 'unli_provisional', 'unli_reconcile'];
  const page = Math.floor(st.offset / st.limit) + 1;
  const pages = Math.max(1, Math.ceil(d.total / st.limit));
  setWork(`
    <div class="card">
      <div class="card-h">
        <div><h2>Every stock change</h2><p>${d.total} records · a permanent history that can't be edited or deleted, so it can always be trusted</p></div>
        <div class="r">
          <select class="field-sm" data-act="mv-reason">${reasons.map(r => `<option value="${r}" ${st.reason === r ? 'selected' : ''}>${r ? esc(reasonLabel(r)) : 'All reasons'}</option>`).join('')}</select>
          <button class="btn btn-s" data-act="export-ledger">Download as spreadsheet (CSV)</button>
        </div>
      </div>
      <div class="tw"><table>
        <thead><tr><th>When</th><th>Ingredient</th><th>What happened</th><th class="n">Change</th><th class="n">Stock after</th><th>Linked to</th><th>Note</th></tr></thead>
        <tbody>${d.entries.length ? d.entries.map(e => `
          <tr>
            <td class="sub">${esc(e.created_at)}</td>
            <td class="nm">${esc(e.ingredient_name)}</td>
            <td>${reasonChip(e.reason)}</td>
            <td class="n" style="color:${e.delta_base < 0 ? 'var(--bad-text)' : 'var(--ok-text)'}">${e.delta_base > 0 ? '+' : ''}${num(e.delta_base, 2)} ${esc(e.base_unit)}</td>
            <td class="n">${num(e.balance_after_base, 2)} ${esc(e.base_unit)}</td>
            <td class="sub">${esc(e.ref_type || '—')}${e.ref_id ? ' #' + esc(e.ref_id) : ''}</td>
            <td class="sub wrap">${esc(e.note || e.wastage_reason || '—')}</td>
          </tr>`).join('') : `<tr><td colspan="7">${emptyState('No movements yet', 'Nothing has been received or deducted in this filter.')}</td></tr>`}
        </tbody>
      </table></div>
      <div class="card-b tight" style="display:flex;justify-content:space-between;align-items:center">
        <span class="sub">Page ${page} of ${pages}</span>
        <div class="toolbar"><button class="btn btn-s" data-act="mv-prev" ${st.offset <= 0 ? 'disabled' : ''}>Previous</button><button class="btn btn-s" data-act="mv-next" ${st.offset + st.limit >= d.total ? 'disabled' : ''}>Next</button></div>
      </div>
    </div>
  `);
}

// ===========================================================================
// Recipes
// ===========================================================================
async function loadRecipes() {
  const d = await api('/console/recipes');
  STATE.recipes.list = d.recipes;
  if (STATE.recipes.selectedId) {
    try { STATE.recipes.detail = await api('/console/recipes/' + STATE.recipes.selectedId); }
    catch (e) { STATE.recipes.detail = null; STATE.recipes.selectedId = null; }
  }
  renderRecipes();
}
function renderRecipes() {
  const list = STATE.recipes.list, sel = STATE.recipes.selectedId, det = STATE.recipes.detail;
  setWork(`
    <div class="grid" style="grid-template-columns:1.1fr 1.4fr;align-items:start">
      <div class="card">
        <div class="card-h"><h2>Recipes</h2><p>${list.length} active — menu items and house-made components (like sauces)</p></div>
        <div class="tw"><table><thead><tr><th>Name</th><th>Type</th><th class="n">Ingredients</th></tr></thead>
        <tbody>${list.length ? list.map(r => `<tr style="cursor:pointer;${sel === r.id ? 'background:var(--amber-wash)' : ''}" data-act="recipe-select" data-id="${r.id}">
          <td class="nm">${esc(r.name)}</td>
          <td><span class="chip ${r.kind === 'menu' ? 'info' : 'fore'}">${r.kind === 'menu' ? 'Menu item' : 'House-made'}</span>${r.unmapped_count ? ` <span class="chip bad">${r.unmapped_count} not matched</span>` : ''}</td>
          <td class="n">${r.line_count}</td>
        </tr>`).join('') : `<tr><td colspan="3">${emptyState('No recipes yet', '')}</td></tr>`}</tbody></table></div>
      </div>
      <div>${det ? recipeDetail(det) : `<div class="card"><div class="card-b">${emptyState('Select a recipe', 'Pick a row on the left to see its full ingredient breakdown, cost, and any problems.')}</div></div>`}</div>
    </div>
  `);
}
function recipeDetail(det) {
  const r = det.recipe, cost = det.cost;
  return `
    <div class="card" style="margin-bottom:12px">
      <div class="card-h"><div><h2>${esc(r.name)}</h2><p>${r.kind === 'menu' ? 'Menu item' : 'House-made component'} · makes ${num(r.yield_qty)} ${esc(r.yield_unit)}</p></div></div>
      <div class="card-b">
        ${det.problems.length ? `<div class="stub" style="background:var(--bad-wash);margin-bottom:12px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg><div><b style="color:var(--bad-text)">Problems with this recipe</b><p>${det.problems.map(esc).join('<br>')}</p></div></div>` : ''}
        <div class="grid g2">
          <div class="kpi"><div class="l">Cost to make</div><div class="v">${cost.complete ? money(cost.total_cost) : '~' + money(cost.total_cost)}</div>${!cost.complete ? `<div class="f">no price set yet for: ${esc(cost.unpriced_ingredients.join(', '))}</div>` : ''}</div>
          <div class="kpi"><div class="l">Ingredients not matched yet</div><div class="v">${det.unmapped.length}</div></div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-h"><h2>Full ingredient breakdown</h2></div>
      <div class="tw"><table><thead><tr><th>Ingredient</th><th class="n">Amount used</th><th>Status</th></tr></thead>
      <tbody>${det.expanded_leaves.length ? det.expanded_leaves.map(l => `<tr><td class="nm">${esc(l.name)}</td><td class="n">${num(l.qty_base, 3)} ${esc(l.base_unit)}</td><td>${l.deductable ? `<span class="chip ok">Ready</span>` : `<span class="chip bad">${esc(l.block_reason || 'Blocked')}</span>`}</td></tr>`).join('') : `<tr><td colspan="3">${emptyState('Nothing to show', '')}</td></tr>`}</tbody></table></div>
    </div>
  `;
}

// ===========================================================================
// Purchases (receiving history)
// ===========================================================================
async function loadPurchases() {
  const d = await api('/console/ledger?reason=purchase_receipt&limit=100');
  STATE.purchases = d;
  setWork(`
    <div class="stub" style="background:var(--info-wash)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
      <div><b style="color:var(--info-text)">Every delivery you've logged so far</b><p>To log a new one, go to Inventory and press "Receive" on the ingredient. There's no way yet to place an order in advance or track a delivery that hasn't arrived — only to record one once it's here.</p></div>
    </div>
    <div class="card">
      <div class="card-h"><div><h2>Deliveries received</h2><p>${d.total} total</p></div><div class="r"><button class="btn btn-p" data-nav="inventory">Go log a delivery</button></div></div>
      <div class="tw"><table><thead><tr><th>When</th><th>Ingredient</th><th class="n">Amount received</th><th>Reference</th><th>Logged by</th></tr></thead>
      <tbody>${d.entries.length ? d.entries.map(e => `<tr><td class="sub">${esc(e.created_at)}</td><td class="nm">${esc(e.ingredient_name)}</td><td class="n">+${num(e.delta_base, 2)} ${esc(e.base_unit)}</td><td class="sub">${esc(e.note || '—')}</td><td class="sub">${esc(e.user_id || '—')}</td></tr>`).join('') : `<tr><td colspan="5">${emptyState('No deliveries recorded yet', 'Use Receive on an ingredient in Inventory to log the first one.')}</td></tr>`}</tbody></table></div>
    </div>
  `);
}

// ===========================================================================
// Forecasts (Phase 3, real) — ingredient runway + item demand
// ===========================================================================
function methodNote(text) {
  return `<div class="stub" style="margin-bottom:0">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
    <div><b style="color:var(--fore-text)">How this works</b><p>${esc(text)}</p></div>
  </div>`;
}
function riskChip(risk) {
  const map = { out: 'bad', critical: 'bad', warning: 'warn', idle: 'mute', ok: 'ok', no_data: 'mute' };
  const label = { out: 'Out of stock', critical: 'Reorder now', warning: 'Reorder soon', idle: 'Not selling lately', ok: 'Enough stock', no_data: 'No sales yet' };
  return `<span class="chip ${map[risk]}">${esc(label[risk])}</span>`;
}
async function loadForecasts() {
  const [dep, dem] = await Promise.all([
    api('/console/forecasts/depletion?lookback_days=30'),
    api('/console/forecasts/demand?horizon_days=7&lookback_days=60'),
  ]);
  STATE.forecasts = { dep: dep.ingredients, dem: dem.items };
  renderForecasts();
}
function renderForecasts() {
  const dep = STATE.forecasts.dep, dem = STATE.forecasts.dem;
  const atRisk = dep.filter(i => i.risk === 'out' || i.risk === 'critical');
  const warn = dep.filter(i => i.risk === 'warning');
  const noData = dep.filter(i => i.risk === 'no_data');
  const readyItems = dem.filter(d => !d.insufficient_data);
  setWork(`
    ${methodNote('Looks at how fast each ingredient has actually been used recently, and works out roughly how many days of stock are left at that pace — compared against how many days it normally takes a delivery to arrive, so it can warn you in time. The table below uses a quick daily-average estimate for every item at once; press "View chart" on any item for its real forecast (a model called Prophet, fit on that item alone) with a predicted range, not just one number. Nothing is guessed — items and ingredients without enough real sales yet are labeled as such instead of shown a made-up number.')}
    <div class="grid g3">
      ${kpi('Reorder now', atRisk.length, 'out of stock or nearly there')}
      ${kpi('Reorder soon', warn.length, '')}
      ${kpi('No sales data yet', noData.length, `of ${dep.length} ingredients`)}
    </div>
    <div class="card">
      <div class="card-h"><div><h2>How long will stock last</h2><p>Soonest to run out shown first</p></div>
      <div class="r"><button class="btn btn-s" data-act="export-depletion">Download</button><button class="btn btn-s" data-act="print-section">Print</button></div></div>
      <div class="tw"><table><thead><tr><th>Ingredient</th><th class="n">On hand</th><th class="n">Used per day (avg.)</th><th class="n">Days left</th><th class="n">Delivery time</th><th>Status</th></tr></thead>
      <tbody>${dep.length ? dep.slice(0, 30).map(i => `<tr>
        <td class="nm">${esc(i.name)}</td>
        <td class="n">${num(i.available_base, 2)} ${esc(i.base_unit)}</td>
        <td class="n">${i.avg_daily_consumption ? num(i.avg_daily_consumption, 3) + ' ' + esc(i.base_unit) + '/day' : '—'}</td>
        <td class="n">${i.days_remaining != null ? num(i.days_remaining, 1) : '—'}</td>
        <td class="n">${i.lead_time_days} day${i.lead_time_days === 1 ? '' : 's'}</td>
        <td>${riskChip(i.risk)}</td>
      </tr>`).join('') : `<tr><td colspan="6">${emptyState('No ingredients to show', '')}</td></tr>`}</tbody></table></div>
      ${dep.length > 30 ? `<div class="card-b tight sub">Showing the 30 most urgent of ${dep.length} ingredients.</div>` : ''}
    </div>
    <div class="card">
      <div class="card-h"><div><h2>What's likely to sell</h2><p>${readyItems.length} of ${dem.length} menu items have ${MIN_DEMAND_DAYS}+ days of real sales to predict from</p></div></div>
      <div class="tw"><table><thead><tr><th>Item</th><th class="n">Days it sold</th><th class="n">Average per day recently</th><th class="n">Predicted, next 7 days</th><th></th></tr></thead>
      <tbody>${dem.length ? dem.map(d => `<tr>
        <td class="nm">${esc(d.name)}</td>
        <td class="n">${d.active_days}</td>
        <td class="n">${d.insufficient_data ? '—' : num(d.trailing_avg_daily, 2)}</td>
        <td class="n">${d.insufficient_data ? `<span class="sub">needs ${d.required_days}+ days of sales (has ${d.active_days})</span>` : num(d.forecast.reduce((s, f) => s + f.qty, 0), 1)}</td>
        <td>${d.insufficient_data ? '' : `<button class="btn btn-s" style="height:26px;padding:0 10px" data-act="demand-chart" data-id="${d.menu_item_id}">View chart</button>`}</td>
      </tr>`).join('') : `<tr><td colspan="5">${emptyState('No menu items', '')}</td></tr>`}</tbody></table></div>
    </div>
  `);
}
const MIN_DEMAND_DAYS = 7;
async function openDemandChartModal(menuItemId) {
  openModal(`
    <h3>Loading forecast…</h3>
    <p>Fitting a real model to this item's sales history — takes a few seconds.</p>
    <div class="bar-wrap" style="height:130px;align-items:center;justify-content:center"><span class="sub">Working…</span></div>
    <div class="actions"><button class="btn btn-s" data-act="modal-cancel" style="flex:1">Cancel</button></div>
  `);
  let d;
  try {
    d = await api('/console/forecasts/demand?menu_item_pk=' + menuItemId + '&horizon_days=7');
  } catch (e) {
    if ($('#modalBox')) openModal(`<h3>Couldn't load this forecast</h3><p>${esc(e.message)}</p><div class="actions"><button class="btn btn-s" data-act="modal-cancel" style="flex:1">Close</button></div>`);
    return;
  }
  if (!$('#modalBox')) return; // cancelled while loading
  renderDemandChartModal(d);
}
function demandLineChart(history, forecast) {
  const hasRange = forecast.length && forecast[0].low !== undefined;
  const allY = [...history.map(p => p.qty), ...forecast.map(p => hasRange ? p.high : p.qty), 1];
  const maxY = Math.max(...allY);
  const W = 640, H = 190, PADL = 30, PADR = 10, PADT = 12, PADB = 24;
  const n = history.length + forecast.length;
  const stepX = (W - PADL - PADR) / Math.max(1, n - 1);
  const xAt = i => PADL + i * stepX;
  const yAt = v => H - PADB - (v / (maxY || 1)) * (H - PADT - PADB);
  const lastHistIdx = history.length - 1;

  const histPts = history.map((p, i) => `${xAt(i)},${yAt(p.qty)}`).join(' ');
  const foreLine = [`${xAt(lastHistIdx)},${yAt(history[lastHistIdx].qty)}`,
    ...forecast.map((p, i) => `${xAt(lastHistIdx + 1 + i)},${yAt(p.qty)}`)].join(' ');

  let band = '';
  if (hasRange) {
    const top = forecast.map((p, i) => `${xAt(lastHistIdx + 1 + i)},${yAt(p.high)}`);
    const bot = forecast.map((p, i) => `${xAt(lastHistIdx + 1 + i)},${yAt(p.low)}`).reverse();
    const start = `${xAt(lastHistIdx)},${yAt(history[lastHistIdx].qty)}`;
    band = `<path d="M ${start} L ${top.join(' L ')} L ${bot.join(' L ')} Z" fill="var(--fore-fill)" opacity="0.16"></path>`;
  }

  const gridY = [0, 0.5, 1].map(f => {
    const v = maxY * f;
    return `<line x1="${PADL}" y1="${yAt(v)}" x2="${W - PADR}" y2="${yAt(v)}" stroke="var(--border-soft)" stroke-width="1"></line>
            <text x="2" y="${yAt(v) + 3}" font-size="9" fill="var(--text-3)">${Math.round(v)}</text>`;
  }).join('');

  const dividerX = xAt(lastHistIdx);
  const firstLbl = history[0]?.date?.slice(5) || '';
  const lastLbl = forecast[forecast.length - 1]?.date?.slice(5) || history[lastHistIdx]?.date?.slice(5) || '';

  return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:170px;overflow:visible">
    ${gridY}
    ${band}
    <line x1="${dividerX}" y1="${PADT}" x2="${dividerX}" y2="${H - PADB}" stroke="var(--border)" stroke-dasharray="3,3"></line>
    <polyline points="${histPts}" fill="none" stroke="var(--amber)" stroke-width="2.5"></polyline>
    <polyline points="${foreLine}" fill="none" stroke="var(--fore-fill)" stroke-width="2.5" stroke-dasharray="5,4"></polyline>
    <text x="${PADL}" y="${H - 6}" font-size="10" fill="var(--text-3)">${esc(firstLbl)}</text>
    <text x="${W - PADR}" y="${H - 6}" font-size="10" fill="var(--text-3)" text-anchor="end">${esc(lastLbl)}</text>
  </svg>`;
}
function renderDemandChartModal(d) {
  if (d.insufficient_data) {
    openModal(`<h3>${esc(d.name)}</h3><p>${emptyState('Not enough sales yet', `Needs ${d.required_days}+ days with a sale — has ${d.active_days}.`)}</p><div class="actions"><button class="btn btn-s" data-act="modal-cancel" style="flex:1">Close</button></div>`);
    return;
  }
  const last14 = d.series.slice(-14);
  const hasRange = d.forecast.length && d.forecast[0].low !== undefined;
  const method = d.prophet_unavailable
    ? 'Quick estimate — the full forecasting model isn’t available on this server right now'
    : (d.method === 'prophet' ? 'Real forecasting model (Prophet), fit on this item’s own history' : 'Quick estimate from recent daily sales');
  openModal(`
    <h3>${esc(d.name)}</h3>
    <p>Actually sold, last 14 days (amber) and predicted, next ${d.forecast.length} days (purple)${d.seasonality_applied ? ', adjusted for day of the week' : ''}${hasRange ? ' — shaded band is the likely range' : ''}</p>
    ${demandLineChart(last14, d.forecast)}
    <p class="sub" style="margin-top:6px">${esc(method)}</p>
    <div class="actions"><button class="btn btn-s" data-act="modal-cancel" style="flex:1">Close</button></div>
  `);
  const box = $('#modalBox');
  if (box) box.style.width = 'min(560px, 92vw)';
}

// ===========================================================================
// Anomaly Detection (Phase 3, real) — z-score + rule-based ledger outliers
// ===========================================================================
async function loadAnomaly() {
  const d = await api('/console/anomalies?lookback_days=90');
  STATE.anomaly = d.anomalies;
  renderAnomaly();
}
const ANOMALY_METHOD_LABELS = {
  isolation_forest: 'Unusual pattern',
  large_fraction: 'Big one-time loss',
};
function renderAnomaly() {
  const list = STATE.anomaly;
  const high = list.filter(a => a.severity === 'high');
  setWork(`
    ${methodNote('Automatically double-checks every waste, spoilage, and stock-count entry from the last 90 days, and flags anything that looks out of the ordinary for that ingredient — either a loss far bigger than usual, or a single loss big enough to matter even with no history to compare it to. (Uses a machine-learning model called Isolation Forest, plus a simple backup rule.)')}
    <div class="grid g2">
      ${kpi('Flagged', list.length, 'last 90 days')}
      ${kpi('Needs attention now', high.length, '')}
    </div>
    <div class="card">
      <div class="card-h"><div><h2>Flagged entries</h2><p>Most recent first</p></div></div>
      <div class="tw"><table><thead><tr><th>When</th><th>Ingredient</th><th>What happened</th><th class="n">Amount</th><th>Flagged because</th><th>Details</th><th>Priority</th></tr></thead>
      <tbody>${list.length ? list.map(a => `<tr>
        <td class="sub">${esc(a.created_at)}</td>
        <td class="nm">${esc(a.ingredient_name)}</td>
        <td>${reasonChip(a.reason)}</td>
        <td class="n">${num(a.delta_base, 2)} ${esc(a.base_unit)}</td>
        <td class="sub">${esc(ANOMALY_METHOD_LABELS[a.method] || a.method)}</td>
        <td class="sub wrap">${esc(a.why)}</td>
        <td><span class="chip ${a.severity === 'high' ? 'bad' : 'warn'}">${a.severity === 'high' ? 'Review soon' : 'Worth a look'}</span></td>
      </tr>`).join('') : `<tr><td colspan="7">${emptyState('Nothing flagged', 'No waste, spoilage, or stock-count entries in the last 90 days looked out of the ordinary — including if there simply aren’t any yet.')}</td></tr>`}</tbody></table></div>
    </div>
  `);
}

// ===========================================================================
// Expiry monitor
// ===========================================================================
async function loadExpiry() {
  const [d, dep] = await Promise.all([
    api('/console/expiry?within_days=' + STATE.expiry.within),
    api('/console/forecasts/depletion?lookback_days=30'),
  ]);
  const burnRate = {};
  dep.ingredients.forEach(i => { burnRate[i.ingredient_id] = i.avg_daily_consumption; });
  STATE.expiry.data = d.batches.map(b => {
    const rate = burnRate[b.ingredient_id];
    const usesUpIn = rate ? b.qty_base / rate : null;
    return { ...b, uses_up_in_days: usesUpIn, at_risk: !b.expired && (usesUpIn == null || usesUpIn > b.days_to_expiry) };
  });
  renderExpiry();
}
const EXPIRY_BUCKETS = [
  { key: 'expired', label: 'Expired or today', test: b => b.expired },
  { key: 'soon', label: 'Within 7 days', test: b => !b.expired && b.days_to_expiry <= 7 },
  { key: 'month', label: '8–30 days', test: b => !b.expired && b.days_to_expiry > 7 && b.days_to_expiry <= 30 },
  { key: 'later', label: '31–90 days', test: b => !b.expired && b.days_to_expiry > 30 },
];
function renderExpiry() {
  const st = STATE.expiry, list = st.data;
  const windows = [7, 30, 90, 180];
  const buckets = EXPIRY_BUCKETS.map(bk => ({ ...bk, items: list.filter(bk.test) }));
  setWork(`
    <div class="grid g4">${buckets.map(bk => kpi(bk.label, bk.items.length, 'batches')).join('')}</div>
    <div class="card">
      <div class="card-h"><div><h2>What's expiring, soonest first</h2><p>Use the oldest stock first to avoid waste</p></div>
      <div class="r">
        <div class="tabs">${windows.map(w => `<button class="tab ${st.within === w ? 'on' : ''}" data-act="exp-window" data-w="${w}">${w}d</button>`).join('')}</div>
        <button class="btn btn-s" data-act="export-expiry">Download</button>
        <button class="btn btn-s" data-act="print-section">Print</button>
      </div></div>
      <div class="card-b" style="display:flex;flex-direction:column;gap:20px">
        ${list.length ? buckets.filter(bk => bk.items.length).map(bk => expiryBucketSection(bk, st.within)).join('')
          : emptyState('Nothing expiring in this window', 'Widen the window above or check back later.')}
      </div>
    </div>
  `);
}
function expiryBucketSection(bucket, withinDays) {
  const dotColor = bucket.key === 'expired' || bucket.key === 'soon' ? 'var(--bad-fill)'
    : bucket.key === 'month' ? 'var(--warn-fill)' : 'var(--info-fill)';
  return `
    <div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
        <span style="width:7px;height:7px;border-radius:99px;background:${dotColor};display:inline-block"></span>
        <b style="font-size:12.5px">${esc(bucket.label)}</b><span class="sub">${bucket.items.length} batch${bucket.items.length === 1 ? '' : 'es'}</span>
      </div>
      <div class="grid g3">${bucket.items.map(b => expiryCard(b, withinDays)).join('')}</div>
    </div>`;
}
function expiryCard(b, withinDays) {
  const pct = Math.max(4, 100 - Math.min(100, (b.days_to_expiry / withinDays) * 100));
  const barColor = b.expired ? 'var(--bad-fill)' : b.days_to_expiry <= 7 ? 'var(--bad-fill)' : b.days_to_expiry <= 30 ? 'var(--warn-fill)' : 'var(--info-fill)';
  return `
    <div class="card" style="box-shadow:none">
      <div class="card-b tight" style="padding:12px">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px">
          <span class="nm">${esc(b.ingredient_name)}</span>
          <span class="sub">${b.expired ? 'expired' : b.days_to_expiry + 'd'}</span>
        </div>
        <div class="sub" style="margin:2px 0 8px">${esc(b.lot_no || '—')}</div>
        <div style="height:5px;border-radius:99px;background:var(--sunken);overflow:hidden;margin-bottom:8px">
          <div style="height:100%;width:${pct}%;background:${barColor};border-radius:99px"></div>
        </div>
        <div class="sub">${num(b.qty_base, 2)} ${esc(b.base_unit)} · exp ${esc(b.expires_at)}</div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px">
          <span class="sub">${b.uses_up_in_days != null ? `uses up in ${num(b.uses_up_in_days, 0)}d` : 'not selling lately'}</span>
          ${b.at_risk ? `<span class="chip warn">May go to waste</span>` : (b.expired ? '' : `<span class="chip ok">On track</span>`)}
        </div>
      </div>
    </div>`;
}

// ===========================================================================
// Needs verification
// ===========================================================================
async function loadVerification() {
  STATE.verification.data = await api('/console/queues/verification');
  STATE.verification.field = '';
  renderVerification();
}
const VERIFY_FIELD_LABELS = {
  'ingredient.pack_size': 'Pack size',
  'ingredient.yield_factor': 'Usable amount (%)',
  'ingredient.unit_cost': 'Cost',
  'recipe_line.qty_base': 'Recipe amount',
  'fefo_batch.expires_at': 'Expiry date',
  'unli_coefficient.lambda': 'Unlimited wings rate',
};
function verifyFieldLabel(f) { return VERIFY_FIELD_LABELS[f] || f; }
function verifyAction(i) {
  if (i.field.startsWith('ingredient.')) {
    const field = i.field.split('.')[1];
    return `<button class="btn btn-s" style="height:28px;padding:0 10px" data-act="verify" data-id="${i.row_id}" data-field="${field}" data-name="${esc(i.entity_name)}" data-current="${esc(i.current_value || '')}">Confirm</button>`;
  }
  if (i.field === 'recipe_line.qty_base') return `<span class="sub">Fix this in Recipes</span>`;
  if (i.field === 'fefo_batch.expires_at') return `<span class="sub">Set next time you receive this item</span>`;
  if (i.field === 'unli_coefficient.lambda') return `<span class="sub">Not editable here yet</span>`;
  return `<span class="sub">—</span>`;
}
const VERIFY_ROW_CAP = 150;
function renderVerification() {
  const d = STATE.verification.data;
  const st = STATE.verification;
  const fields = Object.keys(d.by_field).sort();
  let list = d.items;
  if (st.field) list = list.filter(i => i.field === st.field);
  const shown = list.slice(0, VERIFY_ROW_CAP);
  setWork(`
    <div class="card">
      <div class="card-h">
        <div><h2>Numbers that need a real value</h2><p>${d.count} placeholders left over from setup, waiting to be confirmed with the real number</p></div>
        <div class="r"><button class="btn btn-s" data-act="export-verification">Download as spreadsheet (CSV)</button></div>
      </div>
      <div class="card-b tight" style="padding-top:14px">
        <div class="tabs">
          <button class="tab ${!st.field ? 'on' : ''}" data-act="verify-field" data-f="">All (${d.count})</button>
          ${fields.map(f => `<button class="tab ${st.field === f ? 'on' : ''}" data-act="verify-field" data-f="${f}">${esc(verifyFieldLabel(f))} (${d.by_field[f]})</button>`).join('')}
        </div>
      </div>
      <div class="tw"><table><thead><tr><th>What</th><th>Item</th><th>Placeholder value</th><th>Details</th><th></th></tr></thead>
      <tbody>${shown.length ? shown.map(i => `<tr>
        <td><span class="chip warn">${esc(verifyFieldLabel(i.field))}</span></td>
        <td class="nm">${esc(i.entity_name)}</td>
        <td class="n">${esc(i.current_value === null || i.current_value === undefined ? '—' : i.current_value)}</td>
        <td class="sub">${esc(i.context || '—')}</td>
        <td>${verifyAction(i)}</td>
      </tr>`).join('') : `<tr><td colspan="5">${emptyState('Nothing to verify', 'Every physical constant has a confirmed value.')}</td></tr>`}</tbody></table></div>
      ${list.length > VERIFY_ROW_CAP ? `<div class="card-b tight sub">Showing first ${VERIFY_ROW_CAP} of ${list.length} — narrow with a field tab above or export the full list as CSV.</div>` : ''}
    </div>
  `);
}

// ===========================================================================
// Ingredient (unmapped) queue
// ===========================================================================
async function loadUnmapped() {
  const [u, ing] = await Promise.all([api('/console/queues/unmapped'), api('/console/ingredients?limit=500')]);
  STATE.unmapped.data = u;
  STATE.unmapped.ingredients = ing.ingredients;
  renderUnmapped();
}
const UNMAPPED_REASON_LABELS = {
  no_stock_record: 'Not found in inventory',
  ambiguous: 'Matched more than one ingredient',
  not_stocked: 'Not tracked as stock',
  utility: 'Water/utility, not a real ingredient',
};
function renderUnmapped() {
  const d = STATE.unmapped.data;
  setWork(`
    <div class="card">
      <div class="card-h"><div><h2>Ingredients that need matching</h2><p>${d.count} ingredients from recipes that couldn't be matched to inventory automatically — each one blocks every menu item that uses it</p></div></div>
      <div class="tw"><table><thead><tr><th>Menu item / recipe</th><th>Written as</th><th>Amount</th><th>Why it wasn't matched</th><th class="n">Menu items affected</th><th></th></tr></thead>
      <tbody>${d.items.length ? d.items.map(i => `<tr>
        <td class="nm">${esc(i.source_recipe_name || '—')}</td>
        <td>${esc(i.source_ingredient_label)}</td>
        <td class="sub">${i.parsed_qty != null ? num(i.parsed_qty, 3) + ' ' + esc(i.parsed_unit || '') : '—'}</td>
        <td><span class="chip warn">${esc(UNMAPPED_REASON_LABELS[i.reason] || i.reason)}</span></td>
        <td class="n">${i.blocks_menu_items}</td>
        <td class="toolbar">
          <button class="btn btn-p" style="height:28px;padding:0 10px" data-act="resolve-map" data-id="${i.id}" data-label="${esc(i.source_ingredient_label)}">Match it</button>
          <button class="btn btn-s" style="height:28px;padding:0 10px" data-act="resolve-dismiss" data-id="${i.id}">Ignore</button>
        </td>
      </tr>`).join('') : `<tr><td colspan="6">${emptyState('Nothing waiting', 'Every recipe ingredient has been matched to a real ingredient.')}</td></tr>`}</tbody></table></div>
    </div>
  `);
}

// ===========================================================================
// Reports
// ===========================================================================
function inventoryValuation() {
  const list = STATE.inventory.data || [];
  let total = 0, priced = 0; const missing = [];
  list.forEach(i => {
    if (i.unit_cost != null && i.pack_size) { total += (i.unit_cost / (i.pack_size * (i.yield_factor || 1))) * i.on_hand_base; priced++; }
    else missing.push(i.name);
  });
  return { total, priced, total_count: list.length, missing };
}
async function loadReports() {
  if (!STATE.inventory.data.length) {
    try { const inv = await api('/console/ingredients?limit=500'); STATE.inventory.data = inv.ingredients; } catch (e) { /* valuation card just shows zero */ }
  }
  const [sales, combos] = await Promise.all([
    api('/console/reports/sales?days=' + STATE.reports.days),
    api('/console/combinations'),
  ]);
  STATE.reports.data = sales;
  STATE.reports.combos = combos;
  renderReports();
}
async function fetchReports() {
  STATE.reports.data = await api('/console/reports/sales?days=' + STATE.reports.days);
  renderReports();
}
function renderReports() {
  const d = STATE.reports.data;
  const combos = STATE.reports.combos;
  const windows = [1, 7, 30, 90];
  const val = inventoryValuation();
  setWork(`
    <div class="card">
      <div class="card-h"><div><h2>Sales report</h2><p>Real orders only — nothing here is simulated</p></div>
      <div class="r"><div class="tabs">${windows.map(w => `<button class="tab ${STATE.reports.days === w ? 'on' : ''}" data-act="rep-window" data-w="${w}">${w}d</button>`).join('')}</div>
      <button class="btn btn-s" data-act="export-sales">Download as spreadsheet (CSV)</button></div></div>
      <div class="card-b">
        <div class="grid g3">
          ${kpi('Orders', d.orders, `${d.window_days}-day window`)}
          ${kpi('Covers', d.covers, '')}
          ${kpi('Revenue', money(d.revenue), '')}
        </div>
        <div style="margin-top:16px">${barChart(d.by_item.slice(0, 10), { label: 'name', value: 'revenue', isMoney: true })}</div>
      </div>
      <div class="tw"><table><thead><tr><th>Item</th><th class="n">Qty sold</th><th class="n">Revenue</th></tr></thead>
      <tbody>${d.by_item.length ? d.by_item.map(i => `<tr><td class="nm">${esc(i.name)}</td><td class="n">${num(i.qty_sold)}</td><td class="n">${money(i.revenue)}</td></tr>`).join('') : `<tr><td colspan="3">${emptyState('Nothing sold yet', '')}</td></tr>`}</tbody></table></div>
    </div>
    <div class="card">
      <div class="card-h"><h2>Inventory valuation</h2><p>On-hand stock at last confirmed unit cost — ingredients missing a cost are excluded and listed</p></div>
      <div class="card-b">
        <div class="grid g2">
          ${kpi('Valued stock on hand', money(val.total), `${val.priced} of ${val.total_count} ingredients priced`)}
          ${kpi('Missing a unit cost', val.missing.length, val.missing.slice(0, 3).join(', ') + (val.missing.length > 3 ? '…' : ''))}
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-h"><div><h2>Frequently bought together</h2><p>Real co-occurring items from order history (FP-growth) — pairs that show up together far more than chance would predict</p></div></div>
      <div class="card-b">
        ${combos.insufficient_data
          ? emptyState('Not enough order history yet', `Needs at least ${combos.required} orders to find a reliable pattern — has ${combos.transaction_count} so far.`)
          : (combos.combos.length ? '' : emptyState('No strong combos found yet', 'Nothing co-occurs often enough yet to be more than chance.'))}
      </div>
      ${combos.combos.length ? `<div class="tw"><table><thead><tr><th>Combo</th><th class="n">Seen together</th><th class="n">Times more likely than chance</th><th class="n">Items separately</th><th class="n">Suggested bundle price</th></tr></thead>
      <tbody>${combos.combos.map(c => `<tr>
        <td class="nm">${esc(c.item_a)} + ${esc(c.item_b)}</td>
        <td class="n">${Math.round(c.confidence * 100)}%</td>
        <td class="n">${c.lift.toFixed(1)}x</td>
        <td class="n">${c.individual_total != null ? money(c.individual_total) : '—'}</td>
        <td class="n">${c.suggested_combo_price != null ? money(c.suggested_combo_price) : '—'}</td>
      </tr>`).join('')}</tbody></table></div>` : ''}
    </div>
  `);
}

// ===========================================================================
// System check
// ===========================================================================
async function loadSyscheck() {
  const [r, md] = await Promise.all([
    api('/console/readiness'),
    api('/console/model-details'),
  ]);
  STATE.readiness = r; renderNavBadges();
  const checks = [
    { ok: r.menu_items_blocked === 0, label: 'Every menu item can be sold', detail: `${r.menu_items_sellable} of ${r.menu_items_total} can be sold right now` },
    { ok: r.ingredients_blocked === 0, label: 'No ingredient is blocking a menu item', detail: `${r.ingredients_blocked} missing package size info` },
    { ok: r.unmapped_open === 0, label: 'Every recipe ingredient is matched', detail: `${r.unmapped_open} still unmatched` },
    { ok: r.needs_verification === 0, label: 'No placeholder numbers left', detail: `${r.needs_verification} still need checking` },
  ];
  const allOk = checks.every(c => c.ok);
  setWork(`
    <div class="card">
      <div class="card-h"><div><h2>System check</h2><p>Checked live, right now — not a guess or a saved score</p></div></div>
      <div class="card-b">
        <div class="kpi" style="max-width:260px;margin-bottom:16px">
          <div class="l">Ready for real use</div>
          <div class="v" style="color:${allOk ? 'var(--ok-text)' : 'var(--bad-text)'}">${allOk ? 'Yes' : 'Not yet'}</div>
        </div>
        <div class="grid g2">${checks.map(c => `
          <div class="card" style="box-shadow:none">
            <div class="card-b" style="display:flex;gap:10px;align-items:flex-start">
              <span class="chip ${c.ok ? 'ok' : 'bad'}">${c.ok ? 'Good' : 'Needs attention'}</span>
              <div><div class="nm">${esc(c.label)}</div><div class="sub">${esc(c.detail)}</div></div>
            </div>
          </div>`).join('')}</div>
      </div>
    </div>
    ${modelDetailsCard(md)}
  `);
}
function modelDetailsCard(md) {
  const f = md.demand_forecast, a = md.anomaly_detection, c = md.product_combinations;
  return `
    <div class="card">
      <div class="card-h"><div><h2>Model details</h2><p>Technical evidence for the three Phase 3 models — for review/defense use, not day-to-day operation</p></div></div>
      <div class="card-b">
        <div class="grid g3">
          <div class="card" style="box-shadow:none">
            <div class="card-h"><h2 style="font-size:12.5px">Demand forecasting — Prophet</h2></div>
            <div class="card-b tight" style="font-size:12px;display:flex;flex-direction:column;gap:6px">
              ${f.available ? `
                <div class="sub">Holdout backtest on <b class="nm">${esc(f.item_name)}</b>: trained on ${f.trained_on_days} days, evaluated against ${f.holdout_days} unseen days.</div>
                <div class="grid g2" style="margin-top:6px">
                  ${kpi('MAE', num(f.mae, 2), 'mean absolute error')}
                  ${kpi('RMSE', num(f.rmse, 2), 'root mean sq. error')}
                  ${kpi('MAPE', f.mape != null ? f.mape + '%' : '—', 'mean abs. % error')}
                  ${kpi('Trend', num(f.trend_per_week, 3), 'units/week')}
                </div>` : `<div class="sub">Not available — ${esc(f.reason || 'unknown')}.</div>`}
            </div>
          </div>
          <div class="card" style="box-shadow:none">
            <div class="card-h"><h2 style="font-size:12.5px">Anomaly detection — Isolation Forest</h2></div>
            <div class="card-b tight" style="font-size:12px;display:flex;flex-direction:column;gap:6px">
              <div class="sub">scikit-learn, ${a.n_estimators} estimators, contamination="auto". Trains fresh on every request once ${a.min_pooled_samples}+ comparable ledger entries exist in the window.</div>
              <div class="grid g2" style="margin-top:6px">
                ${kpi('Entries scanned', a.records_evaluated, `last ${a.lookback_days}d`)}
                ${kpi('Model trained', a.trained_this_call ? 'Yes' : 'No', a.trained_this_call ? '' : `needs ${a.min_pooled_samples}+`)}
                ${kpi('Flagged', a.flagged, '')}
                ${kpi('No-history rule', a.rule_fraction_threshold * 100 + '%', 'fallback threshold')}
              </div>
            </div>
          </div>
          <div class="card" style="box-shadow:none">
            <div class="card-h"><h2 style="font-size:12.5px">Product combinations — FP-growth</h2></div>
            <div class="card-b tight" style="font-size:12px;display:flex;flex-direction:column;gap:6px">
              <div class="sub">mlxtend, frequent-itemset mining with lift-filtered association rules.</div>
              <div class="grid g2" style="margin-top:6px">
                ${kpi('Orders analyzed', c.transactions_evaluated, `min ${c.min_transactions} required`)}
                ${kpi('Combos found', c.combos_found, '')}
                ${kpi('Min support', c.min_support, '')}
                ${kpi('Min lift', c.min_lift + 'x', 'vs. random chance')}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>`;
}

// ===========================================================================
// Settings
// ===========================================================================
const CAP_TABLE = [
  { label: 'Create orders', roles: ['cashier', 'admin'] },
  { label: 'Void orders', roles: ['cashier', 'kitchen', 'manager', 'admin'] },
  { label: 'Advance kitchen status', roles: ['kitchen', 'admin'] },
  { label: 'Read inventory', roles: ['manager', 'admin'] },
  { label: 'Write inventory / receive stock', roles: ['manager', 'admin'] },
  { label: 'Read / write recipes', roles: ['manager', 'admin'] },
  { label: 'Resolve queues', roles: ['manager', 'admin'] },
];
function loadSettings() {
  setWork(`
    <div class="card">
      <div class="card-h"><h2>Account</h2></div>
      <div class="card-b"><div class="grid g2">
        ${kpi('Signed in as', NAME, ROLE)}
        ${kpi('Session', 'Active', 'token stored on this device only')}
      </div></div>
    </div>
    <div class="card">
      <div class="card-h"><h2>Role capabilities</h2><p>What each role can actually do on this system</p></div>
      <div class="card-b"><div class="tw"><table><thead><tr><th>Capability</th><th>Cashier</th><th>Kitchen</th><th>Manager</th><th>Admin</th></tr></thead>
      <tbody>${CAP_TABLE.map(c => `<tr><td class="nm">${esc(c.label)}</td>${['cashier', 'kitchen', 'manager', 'admin'].map(r => `<td>${c.roles.includes(r) ? '✓' : '—'}</td>`).join('')}</tr>`).join('')}</tbody></table></div></div>
    </div>
    <div class="card"><div class="card-b"><button class="btn btn-d" data-act="logout">Sign out</button></div></div>
  `);
}

// ===========================================================================
// Router / shell
// ===========================================================================
const SECTIONS = [
  { id: 'dashboard', label: 'Dashboard', ic: '◆' },
  { group: 'Manage' },
  { id: 'inventory', label: 'Inventory', ic: '▦' },
  { id: 'movements', label: 'Stock Movements', ic: '⇅' },
  { id: 'recipes', label: 'Recipes', ic: '☰' },
  { id: 'purchases', label: 'Purchases', ic: '⬇' },
  { group: 'Intelligence' },
  { id: 'forecasts', label: 'Forecasts', ic: '∿' },
  { id: 'anomaly', label: 'Anomaly Detection', ic: '⚠' },
  { id: 'expiry', label: 'Expiry Monitor', ic: '⏳' },
  { group: 'Data Health' },
  { id: 'verification', label: 'Needs Verification', ic: '✓' },
  { id: 'unmapped', label: 'Ingredient Queue', ic: '?' },
  { group: 'Administer' },
  { id: 'reports', label: 'Reports', ic: '▣' },
  { id: 'syscheck', label: 'System Check', ic: '♥' },
  { id: 'settings', label: 'Settings', ic: '⚙' },
];
const TITLES = {
  dashboard: ['Dashboard', "A quick look at stock health and today's sales"],
  inventory: ['Inventory', 'Every ingredient and how much is on hand'],
  movements: ['Stock Movements', 'Every time stock went up or down, and why — a permanent record'],
  recipes: ['Recipes', 'What ingredients go into each menu item, and their cost'],
  purchases: ['Purchases', 'Deliveries received so far'],
  forecasts: ['Forecasts', 'How long stock will last, and what’s likely to sell'],
  anomaly: ['Anomaly Detection', 'Losses that look unusual and worth a second look'],
  expiry: ['Expiry Monitor', 'What’s expiring soon, soonest first'],
  verification: ['Needs Verification', 'Numbers from setup that still need double-checking'],
  unmapped: ['Ingredient Queue', 'Recipe ingredients that couldn’t be matched automatically'],
  reports: ['Reports', 'Sales, product combos, and inventory value'],
  syscheck: ['System Check', 'Is everything set up correctly?'],
  settings: ['Settings', 'Account and access information'],
};
const LOADERS = {
  dashboard: loadDashboard, inventory: loadInventory, movements: loadMovements,
  recipes: loadRecipes, purchases: loadPurchases, forecasts: loadForecasts,
  anomaly: loadAnomaly, expiry: loadExpiry, verification: loadVerification,
  unmapped: loadUnmapped, reports: loadReports, syscheck: loadSyscheck, settings: loadSettings,
};
function navBadge(id) {
  const r = STATE.readiness; if (!r) return '';
  if (id === 'unmapped' && r.unmapped_open) return `<span class="badge">${r.unmapped_open}</span>`;
  if (id === 'verification' && r.needs_verification) return `<span class="badge">${r.needs_verification}</span>`;
  if (id === 'inventory' && r.ingredients_blocked) return `<span class="badge">${r.ingredients_blocked}</span>`;
  return '';
}
function renderNav() {
  const nav = $('#nav');
  nav.innerHTML = SECTIONS.map(s => s.group
    ? `<div class="nav-lbl">${esc(s.group)}</div>`
    : `<button class="nav-i" data-nav="${s.id}"><span class="ic">${s.ic}</span>${esc(s.label)}${navBadge(s.id)}</button>`
  ).join('');
  $all('[data-nav]', nav).forEach(b => b.addEventListener('click', () => goto(b.dataset.nav)));
}
function renderNavBadges() {
  $all('.nav-i').forEach(b => {
    const existing = b.querySelector('.badge'); if (existing) existing.remove();
    const html = navBadge(b.dataset.nav);
    if (html) b.insertAdjacentHTML('beforeend', html);
  });
}

let CURRENT = null;
async function goto(id) {
  if (!TITLES[id]) id = 'dashboard';
  CURRENT = id;
  location.hash = id;
  $all('.nav-i').forEach(b => b.classList.toggle('on', b.dataset.nav === id));
  $('#pgTitle').textContent = TITLES[id][0];
  $('#pgSub').textContent = TITLES[id][1];
  clearErr();
  setWork(`<div class="empty">Loading…</div>`);
  try { await LOADERS[id](); }
  catch (e) { showErr('Could not load this section: ' + e.message); setWork(''); }
}
$('#refreshBtn').addEventListener('click', () => CURRENT && goto(CURRENT));

// Single delegated handler for every interactive element rendered into #work.
$('#work').addEventListener('click', async e => {
  const el = a => e.target.closest(a);
  let t;
  if ((t = el('[data-nav]'))) { goto(t.dataset.nav); return; }
  if ((t = el('[data-act="inv-cat"]'))) { STATE.inventory.cat = t.dataset.cat; renderInventory(); return; }
  if ((t = el('[data-act="receive"]'))) { openReceiveModal(t.dataset.id, t.dataset.name, t.dataset.unit); return; }
  if ((t = el('[data-act="count"]'))) { openCountModal(t.dataset.id, t.dataset.name, t.dataset.baseunit, parseFloat(t.dataset.onhand)); return; }
  if ((t = el('[data-act="verify"]'))) { openVerifyModal(t.dataset.id, t.dataset.field, t.dataset.name, t.dataset.current); return; }
  if ((t = el('[data-act="mv-prev"]'))) { STATE.movements.offset = Math.max(0, STATE.movements.offset - STATE.movements.limit); await fetchMovements(); return; }
  if ((t = el('[data-act="mv-next"]'))) { STATE.movements.offset += STATE.movements.limit; await fetchMovements(); return; }
  if ((t = el('[data-act="exp-window"]'))) { STATE.expiry.within = parseInt(t.dataset.w, 10); await loadExpiry(); return; }
  if ((t = el('[data-act="rep-window"]'))) { STATE.reports.days = parseInt(t.dataset.w, 10); await fetchReports(); return; }
  if ((t = el('[data-act="recipe-select"]'))) { STATE.recipes.selectedId = parseInt(t.dataset.id, 10); await loadRecipes(); return; }
  if ((t = el('[data-act="resolve-map"]'))) { openResolveModal(t.dataset.id, t.dataset.label); return; }
  if ((t = el('[data-act="resolve-dismiss"]'))) { dismissUnmapped(t.dataset.id); return; }
  if ((t = el('[data-act="verify-field"]'))) { STATE.verification.field = t.dataset.f; renderVerification(); return; }
  if ((t = el('[data-act="demand-chart"]'))) {
    openDemandChartModal(parseInt(t.dataset.id, 10));
    return;
  }
  if ((t = el('[data-act="export-verification"]'))) {
    const d = STATE.verification.data;
    if (!d || !d.items.length) { toast('Nothing to export.'); return; }
    downloadCsv('needs_verification.csv', d.items, [
      { label: 'Field', key: 'field' }, { label: 'Entity', key: 'entity_name' },
      { label: 'Current value', key: 'current_value' }, { label: 'Context', key: 'context' },
    ]);
    return;
  }
  if ((t = el('[data-act="export-ledger"]'))) {
    const d = STATE.movements.data;
    if (!d || !d.entries.length) { toast('Nothing to export.'); return; }
    downloadCsv('stock_movements.csv', d.entries, [
      { label: 'When', key: 'created_at' }, { label: 'Ingredient', key: 'ingredient_name' }, { label: 'Reason', key: 'reason' },
      { label: 'Delta', key: 'delta_base' }, { label: 'Balance after', key: 'balance_after_base' }, { label: 'Note', key: 'note' },
    ]);
    return;
  }
  if ((t = el('[data-act="export-sales"]'))) {
    const d = STATE.reports.data;
    if (!d || !d.by_item.length) { toast('Nothing to export.'); return; }
    downloadCsv('sales_by_item.csv', d.by_item, [
      { label: 'Item', key: 'name' }, { label: 'Qty sold', key: 'qty_sold' }, { label: 'Revenue', key: 'revenue' },
    ]);
    return;
  }
  if ((t = el('[data-act="export-expiry"]'))) {
    const list = STATE.expiry.data;
    if (!list || !list.length) { toast('Nothing to export.'); return; }
    downloadCsv('expiring_stock.csv', list, [
      { label: 'Ingredient', key: 'ingredient_name' }, { label: 'Reference', key: 'lot_no' },
      { label: 'Amount', key: 'qty_base' }, { label: 'Unit', key: 'base_unit' },
      { label: 'Received', key: 'received_at' }, { label: 'Expires', key: 'expires_at' },
      { label: 'Days left', key: 'days_to_expiry' },
    ]);
    return;
  }
  if ((t = el('[data-act="export-depletion"]'))) {
    const list = STATE.forecasts.dep;
    if (!list || !list.length) { toast('Nothing to export.'); return; }
    downloadCsv('restocking_list.csv', list, [
      { label: 'Ingredient', key: 'name' }, { label: 'On hand', key: 'available_base' }, { label: 'Unit', key: 'base_unit' },
      { label: 'Used per day (avg)', key: 'avg_daily_consumption' }, { label: 'Days left', key: 'days_remaining' },
      { label: 'Delivery time (days)', key: 'lead_time_days' }, { label: 'Status', key: 'risk' },
    ]);
    return;
  }
  if ((t = el('[data-act="print-section"]'))) { window.print(); return; }
  if ((t = el('[data-act="modal-cancel"]'))) { closeModal(); return; }
  if ((t = el('[data-act="logout"]'))) { doLogout(); return; }
});
$('#work').addEventListener('change', async e => {
  const el = a => e.target.closest(a);
  let t;
  if ((t = el('[data-act="mv-reason"]'))) { STATE.movements.reason = t.value; STATE.movements.offset = 0; await fetchMovements(); return; }
  if ((t = el('[data-act="inv-blocked"]'))) { STATE.inventory.onlyBlocked = t.checked; renderInventory(); return; }
});
$('#work').addEventListener('input', e => {
  const t = e.target.closest('[data-bind="inv-q"]');
  if (!t) return;
  STATE.inventory.q = t.value;
  const pos = t.selectionStart;
  renderInventory();
  const again = $('[data-bind="inv-q"]');
  if (again) { again.focus(); again.setSelectionRange(pos, pos); }
});

function boot() {
  if (TOKEN && ROLE && NAME && ALLOWED_ROLES.includes(ROLE)) {
    $('#login').style.display = 'none';
    $('#app').style.display = 'grid';
    $('#whoName').textContent = NAME;
    $('#whoRole').textContent = ROLE.charAt(0).toUpperCase() + ROLE.slice(1);
    $('#avatarIni').textContent = NAME.slice(0, 2).toUpperCase();
    renderNav();
    goto(location.hash.replace('#', '') || 'dashboard');
  } else if (TOKEN) {
    doLogout();
  }
}
boot();
</script>
</body>
</html>
